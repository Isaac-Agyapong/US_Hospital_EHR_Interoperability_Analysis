    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Words used here",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#0B1F4D",
                      "fontFamily": "Corbel",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  EHR: electronic health record, the software a hospital keeps patient records in",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#141B2D",
                      "fontFamily": "Corbel"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Interoperability: records that can move safely between hospitals, doctors, labs and patients",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#141B2D",
                      "fontFamily": "Corbel"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Met the standards: met Medicare's Promoting Interoperability program for the year (certified EHR, sharing records, e-prescribing, patient online access, reporting to public health)",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#141B2D",
                      "fontFamily": "Corbel"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Fell short: did not meet them, which cuts the hospital's Medicare payments",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#141B2D",
                      "fontFamily": "Corbel"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Small rural (critical access) hospital: 25 beds or fewer, far from other hospitals",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#141B2D",
                      "fontFamily": "Corbel"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Certified EHR ID: the code that names the certified software a hospital used",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#141B2D",
                      "fontFamily": "Corbel"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
