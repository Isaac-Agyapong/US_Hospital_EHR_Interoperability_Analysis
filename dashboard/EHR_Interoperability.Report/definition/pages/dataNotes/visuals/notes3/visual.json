    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Keep in mind",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#D97706",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Only general and small rural hospitals are in the program; psychiatric, children's, VA and military hospitals are left out because they are never rated",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1E293B",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  The yearly files and the latest file cover different reporting years, so a few hospitals differ",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1E293B",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Main EHR company = the company with the most certified products in the hospital's EHR setup",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1E293B",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Links between money, size, software and falling short are associations, not proof of cause",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1E293B",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Puerto Rico and four small territories are included; only Puerto Rico is drawn on the map",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1E293B",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
