	measure 'ID Title' =
			VAR _p = DIVIDE ( [Hospitals] - CALCULATE ( [Hospitals], KEEPFILTERS ( hospital[id_quality] = "Valid ID, found in the federal list" ) ), [Hospitals] )
			RETURN IF ( ISBLANK ( _p ), "What hospitals put in the EHR ID field", FORMAT ( ROUND ( _p * 100, 0 ), "0" ) & " in 100 hospitals have a problem in the EHR ID field" )
		displayFolder: Titles
		lineageTag: b72adf08-51a7-55ac-82e8-f420e763dde9

	measure 'Disagree Title' = FORMAT ( [Disagree Count], "#,0" ) & " hospitals get a different answer in the two Medicare files"
