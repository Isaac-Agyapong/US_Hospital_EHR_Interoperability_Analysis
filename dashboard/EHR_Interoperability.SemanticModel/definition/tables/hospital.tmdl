	partition hospital = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "hospital.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells arrive as "" text; make them real blanks so they drop out of charts
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks,{{"ccn", type text}, {"hospital_label", type text}, {"display_name", type text}, {"city", type text}, {"state", type text}, {"state_name", type text}, {"hospital_type", type text}, {"ownership", type text}, {"rural_urban", type text}, {"in_latest", Int64.Type}, {"not_met", Int64.Type}, {"ehr_status", type text}, {"ehr_group", type text}, {"main_developer", type text}, {"beds", Int64.Type}, {"size_band", type text}, {"size_order", Int64.Type}, {"total_margin", type number}, {"margin_fifth", Int64.Type}, {"margin_fifth_label", type text}, {"lost_money", type text}, {"years_reported", Int64.Type}, {"years_not_met", Int64.Type}, {"history", type text}, {"history_order", Int64.Type}, {"hospitals_sharing_ehr_id", Int64.Type}, {"id_quality", type text}, {"files_disagree", Int64.Type}, {"disagree_type", type text}, {"n_files", Int64.Type}, {"finance_match", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
