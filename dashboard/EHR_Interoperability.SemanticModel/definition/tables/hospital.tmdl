	measure 'Market Share' =
			VAR _d = SELECTEDVALUE ( hospital[main_developer] )
			RETURN IF ( NOT ISBLANK ( _d ), DIVIDE ( [Hospitals],
			    CALCULATE ( [Hospitals], REMOVEFILTERS ( hospital[main_developer] ), NOT ISBLANK ( hospital[main_developer] ) ) ) )
