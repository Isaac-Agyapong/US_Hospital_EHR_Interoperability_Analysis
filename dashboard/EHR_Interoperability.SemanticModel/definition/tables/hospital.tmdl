	measure 'Top 10 Share' =
			// ranks every state (REMOVEFILTERS, not ALLSELECTED), so a click on the map does not make a state #1;
			// states with fewer than 10 hospitals in the current selection are not ranked
			VAR _cur = [Short Share]
			VAR _n = [Hospitals]
			VAR _all = CALCULATETABLE ( FILTER ( ADDCOLUMNS ( VALUES ( states[state_name] ), "@r", [Short Share], "@n", [Hospitals] ), [@n] >= 10 ), REMOVEFILTERS ( states ) )
			RETURN IF ( HASONEVALUE ( states[state_name] ) && _n >= 10 && COUNTROWS ( FILTER ( _all, [@r] > _cur ) ) < 10, _cur )
		formatString: 0%
		displayFolder: States
		lineageTag: 6178c13f-7509-51ba-a38b-1bf7b3023db8

	measure 'Top 10 Hospitals' = IF ( NOT ISBLANK ( [Top 10 Share] ), [Hospitals] )
		formatString: #,0
		displayFolder: States
		lineageTag: 749938ef-a39e-5d71-b5a2-0550efbaa1e4

	measure 'Top 10 Short' = IF ( NOT ISBLANK ( [Top 10 Share] ), [Short] )
		formatString: #,0
		displayFolder: States
		lineageTag: c2fd16f1-597e-53d8-9e2e-779f75611d18

	measure 'Tile Label' = SELECTEDVALUE ( states[state] )
		displayFolder: Map
		lineageTag: 980bf1f0-0c38-51a3-9e2e-0d40afe83f76

	measure 'Tile Colour' =
			VAR _r = [Short Share]
			RETURN SWITCH ( TRUE (),
			    ISBLANK ( SELECTEDVALUE ( states[state] ) ), "#FFFFFF",
			    ISBLANK ( _r ), "#EEF1F6",
			    _r < 0.05, "#FDF0EA",
			    _r < 0.10, "#F9CDBB",
			    _r < 0.15, "#F29A78",
			    _r < 0.25, "#E8552B",
			    "#B23A1C" )
		displayFolder: Map
		lineageTag: 1ba12b64-6996-586d-909e-37dcc04202f1

	measure 'Tile Font' = IF ( [Short Share] >= 0.15, "#FFFFFF", "#141B2D" )
		displayFolder: Map
		lineageTag: 594ee0e2-effb-55fe-af90-cb0e6cb58b9a

	measure 'Fifth States' = COUNTROWS ( FILTER ( CALCULATETABLE ( ADDCOLUMNS ( VALUES ( states[state] ), "@r", [Short Share], "@n", [Hospitals] ), REMOVEFILTERS ( states ) ), [@n] >= 10 && [@r] >= 0.2 ) )
		formatString: #,0
		displayFolder: States
		lineageTag: eeca6a31-d143-5ef7-a136-b4a397546710

	measure 'Zero States' = COUNTROWS ( FILTER ( CALCULATETABLE ( ADDCOLUMNS ( VALUES ( states[state] ), "@s", [Short], "@n", [Hospitals] ), REMOVEFILTERS ( states ) ), [@n] >= 1 && [@s] = 0 ) )
		formatString: #,0
		displayFolder: States
		lineageTag: 6ab6fb3e-77f2-5e2b-8c27-278a37fe0775

	measure 'Map Title' =
			VAR _t = TOPN ( 1, FILTER ( CALCULATETABLE ( ADDCOLUMNS ( VALUES ( states[state_name] ), "@r", [Short Share], "@n", [Hospitals] ), REMOVEFILTERS ( states ) ), [@n] >= 10 ), [@r], DESC )
			RETURN MAXX ( _t, states[state_name] ) & " has the highest share falling short: " & FORMAT ( MAXX ( _t, [@r] ), "0%" ) & " of its hospitals"
		displayFolder: Titles
		lineageTag: d0558e03-744a-5f63-8909-97665fa09dd3

	measure 'Selected State' = SELECTEDVALUE ( states[state_name], "All states" )
		displayFolder: Tooltip
		lineageTag: eac3fece-e636-5520-a82e-ee4fbb15fb71

	measure 'State Rank Text' =
			VAR _cur = [Short Share]
			VAR _all = CALCULATETABLE ( FILTER ( ADDCOLUMNS ( VALUES ( states[state_name] ), "@r", [Short Share], "@n", [Hospitals] ), [@n] >= 10 ), REMOVEFILTERS ( states ) )
			RETURN IF ( HASONEVALUE ( states[state_name] ) && [Hospitals] >= 10, "#" & COUNTROWS ( FILTER ( _all, [@r] > _cur ) ) + 1 & " of "
			    & COUNTROWS ( _all ) & " for the share falling short", "Too few hospitals to rank" )
		displayFolder: Tooltip
		lineageTag: a8ad20cc-11bc-50b2-8062-97076eaddee0

	measure 'State Short Text' = FORMAT ( [Short], "#,0" ) & " of " & FORMAT ( [Hospitals], "#,0" ) & " hospitals"
