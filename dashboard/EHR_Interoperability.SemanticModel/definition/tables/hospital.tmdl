	measure 'ID Title' =
			VAR _p = DIVIDE ( [Hospitals] - CALCULATE ( [Hospitals], hospital[id_quality] = "Valid ID, found in the federal list" ), [Hospitals] )
			RETURN FORMAT ( ROUND ( _p * 100, 0 ), "0" ) & " in 100 hospitals have a problem in the EHR ID field"
