	measure 'Profile Name' = IF ( HASONEVALUE ( hospital[hospital_label] ), SELECTEDVALUE ( hospital[display_name] ), "Pick a hospital" )
		displayFolder: Hospital
		lineageTag: 765a32db-c40e-5514-bbad-0cda3eaf30f8

	measure 'Profile Facts' = IF ( HASONEVALUE ( hospital[hospital_label] ), SELECTEDVALUE ( hospital[hospital_type] ) & "   ·   " & SELECTEDVALUE ( hospital[ownership] ) & "   ·   " & SELECTEDVALUE ( hospital[city] ) & ", " & SELECTEDVALUE ( hospital[state_name] ) & IF ( NOT ISBLANK ( SUM ( hospital[beds] ) ), "   ·   " & FORMAT ( SUM ( hospital[beds] ), "#,0" ) & " beds" ), "Type a hospital name in the search box on the right" )
		displayFolder: Hospital
		lineageTag: d61895b8-09eb-5178-b39a-3e6b0b9b2cda

	measure 'Profile Status' = IF ( HASONEVALUE ( hospital[hospital_label] ), IF ( SUM ( hospital[in_latest] ) = 0, "Not in the 2024 file", IF ( SUM ( hospital[not_met] ) = 1, "Fell short", "Met the standards" ) ) )
		displayFolder: Hospital
		lineageTag: 74f79ff6-4470-564d-844e-80c64a084f93

	measure 'Profile Status Colour' = IF ( SUM ( hospital[not_met] ) = 1, "#FF6B47", "#5B8DEF" )
		displayFolder: Hospital
		lineageTag: 78758bb8-0fdc-5ab0-97ab-e5c7c9f41000

	measure 'Profile Status Context' = IF ( HASONEVALUE ( hospital[hospital_label] ), "in the 2024 reporting year" )
		displayFolder: Hospital
		lineageTag: bb09d4ab-5566-5d80-8ff4-389687bf540d

	measure 'Profile EHR' =
			IF ( HASONEVALUE ( hospital[hospital_label] ), IF ( SELECTEDVALUE ( hospital[ehr_status] ) = "No EHR ID reported", "None reported",
			    COALESCE ( SELECTEDVALUE ( hospital[main_developer] ), "Not identified" ) ) )
		displayFolder: Hospital
		lineageTag: 117eed58-4ada-5001-a1aa-ce52189b149d

	measure 'Profile EHR Colour' = IF ( SELECTEDVALUE ( hospital[ehr_status] ) = "No EHR ID reported", "#A78BFA", "#FFFFFF" )
		displayFolder: Hospital
		lineageTag: 910e68f8-59ec-5c3b-a1bc-baab5a49a847

	measure 'Profile EHR Context' =
			VAR _k = SUM ( hospital[hospitals_sharing_ehr_id] ) - 1
			RETURN IF ( HASONEVALUE ( hospital[hospital_label] ), IF ( SELECTEDVALUE ( hospital[ehr_status] ) = "No EHR ID reported", "no certified EHR ID in the 2024 file",
			    IF ( _k > 0, "same EHR setup as " & _k & " other hospital" & IF ( _k > 1, "s", "" ), "its own EHR setup" ) ) )
		displayFolder: Hospital
		lineageTag: 198a2c52-6be2-5bff-9049-705087681e91

	measure 'Profile Years' = IF ( HASONEVALUE ( hospital[hospital_label] ), IF ( COUNTROWS ( hospital_year ) > 0, FORMAT ( SUM ( hospital_year[not_met] ) + 0, "0" ) & " of " & COUNTROWS ( hospital_year ), "No history" ) )
		displayFolder: Hospital
		lineageTag: 98ae0c03-5c64-5f79-9de5-0f43f4ef459d

	measure 'Profile Years Colour' = IF ( SUM ( hospital_year[not_met] ) > 0, "#FF6B47", "#5B8DEF" )
		displayFolder: Hospital
		lineageTag: 8e9486ab-f3f7-5e58-bee1-28b80c4b87cc

	measure 'Profile Years Context' = IF ( HASONEVALUE ( hospital[hospital_label] ), "yearly Medicare files, 2019-2024" )
		displayFolder: Hospital
		lineageTag: e645e2e6-01aa-5145-a07a-0a11181e8326

	measure 'Profile Margin' = IF ( HASONEVALUE ( hospital[hospital_label] ), IF ( ISBLANK ( SUM ( hospital[total_margin] ) ), "No report", FORMAT ( SUM ( hospital[total_margin] ) * 100, "0.0" ) & " cents" ) )
		displayFolder: Hospital
		lineageTag: ce7bdfc6-a1eb-50d2-811d-68aff739d168

	measure 'Profile Margin Colour' = IF ( SUM ( hospital[total_margin] ) < 0, "#FF6B47", "#FFFFFF" )
		displayFolder: Hospital
		lineageTag: f5249ded-f07a-5425-b3d7-7c1949cf614d

	measure 'Profile Margin Context' =
			IF ( HASONEVALUE ( hospital[hospital_label] ), IF ( ISBLANK ( SUM ( hospital[total_margin] ) ), "no financial report matched",
			    "profit kept from each $1" & IF ( SELECTEDVALUE ( hospital[lost_money] ) = "Lost money 2 years in a row", "; lost money 2 years running", "" ) ) )
		displayFolder: Hospital
		lineageTag: 43eb3fdb-0ebb-5839-bc5c-4f7eefbd9e4b

	measure 'Profile Sentence' =
			VAR _t = SELECTEDVALUE ( hospital[hospital_type] )
			VAR _peer = CALCULATE ( [Short Share], REMOVEFILTERS ( hospital ), REMOVEFILTERS ( states ), hospital[hospital_type] = _t )
			VAR _short = SUM ( hospital[not_met] ) = 1
			VAR _y = SUM ( hospital_year[not_met] ) + 0
			VAR _n = COUNTROWS ( hospital_year )
			RETURN IF ( HASONEVALUE ( hospital[hospital_label] ) && SUM ( hospital[in_latest] ) = 1,
			    "In 2024 this hospital " & IF ( _short, "did not meet", "met" ) & " Medicare's standards for sharing health records electronically. "
			    & FORMAT ( _peer, "0%" ) & IF ( _t = "General hospital", " of general hospitals", " of small rural hospitals" ) & " fell short. "
			    & IF ( _n > 0, "It fell short in " & _y & " of the " & _n & " yearly files since 2019"
			        & IF ( _y = 0, ": a steady record.", IF ( _y = _n, ": it has never met them.", "." ) ), "" )
			    & IF ( SELECTEDVALUE ( hospital[ehr_status] ) = "No EHR ID reported", " It reported no certified EHR, the most common reason hospitals fall short.", "" ),
			    IF ( HASONEVALUE ( hospital[hospital_label] ), "This hospital is not in the latest Medicare file (it may have closed or merged).", "Pick a hospital to see what its numbers mean." ) )
		displayFolder: Hospital
		lineageTag: e0f4041f-0cb1-5f76-9afc-e4e585536705

	measure 'Profile Checks' =
			IF ( HASONEVALUE ( hospital[hospital_label] ) && SUM ( hospital[in_latest] ) = 1, "EHR ID field: " & SELECTEDVALUE ( hospital[id_quality] ) & ". "
			    & IF ( SUM ( hospital[files_disagree] ) = 1, "The two Medicare files give different answers for this hospital.",
			         "The Medicare files agree on its status." ) )
		displayFolder: Hospital
		lineageTag: f0e329e6-e502-5984-b922-bc461c15a414

