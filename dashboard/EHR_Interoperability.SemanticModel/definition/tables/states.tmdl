	column on_map
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 4760305c-d736-5f1b-8b9f-5c0a5f3fe139
		summarizeBy: sum
		sourceColumn: on_map

		annotation SummarizationSetBy = Automatic

	partition states = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "states.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells arrive as "" text; make them real blanks so they drop out of charts
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks,{{"state", type text}, {"state_name", type text}, {"tile_x", Int64.Type}, {"tile_y", Int64.Type}, {"on_map", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
