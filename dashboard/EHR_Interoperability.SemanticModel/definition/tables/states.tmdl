table states
	lineageTag: 0e5631d0-87d4-5b06-8bac-aae637783ca7

	column state
		dataType: string
		lineageTag: ad6922a6-a6a9-5eac-941e-099f52ea28f2
		summarizeBy: none
		sourceColumn: state

		annotation SummarizationSetBy = Automatic

	column state_name
		dataType: string
		lineageTag: 585fbf23-b8be-51b6-9141-4eefdaf36b35
		summarizeBy: none
		sourceColumn: state_name

		annotation SummarizationSetBy = Automatic

	column tile_x
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 1b825d75-bb64-5c61-9b80-44d5b6abf170
		summarizeBy: none
		sourceColumn: tile_x

		annotation SummarizationSetBy = Automatic

	column tile_y
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 6e0e3d71-2841-5068-96be-1083e4b24e6b
		summarizeBy: none
